# I will do Unix socket thanks....
# (I don't like to remember random numbers)
BIND=/run/anubis/nginx.sock
BIND_NETWORK=unix
DIFFICULTY=4
METRICS_BIND=:9090
SERVE_ROBOTS_TXT=0
# Ugh fine, I guess the world knows my backend
# runs on port 3000... that's alright I guess.
# If I play the cards right it should never be
# exposed to the world.
TARGET=http://localhost:3000
WEBMASTER_EMAIL=webmaster+anubis@rapidcow.org
